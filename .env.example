# ---------- Core ----------
DATABASE_URL=postgres://dailyai:dailyai@localhost:5432/dailyai
# Public base URL (used in digests/links)
APP_URL=http://localhost:3000
# Optional Basic Auth for the whole UI/API (user: any, password: APP_PASSWORD). STRONGLY recommended when exposed.
APP_PASSWORD=
# Bearer token for /api/jobs/* (cron). Generate: openssl rand -hex 32
CRON_SECRET=change-me
# 32+ char key used to encrypt secrets stored in the DB. Generate: openssl rand -hex 32
APP_SECRET_KEY=change-me-to-a-long-random-string
# Run DB migrations + seed automatically on server start
AUTO_MIGRATE=true
LOG_LEVEL=info
# Allow fetching private/loopback addresses (local feeds). Keep false in production.
ALLOW_PRIVATE_FETCH=false

# ---------- AI provider ----------
# heuristic | openai-compatible | anthropic
LLM_PROVIDER=heuristic
# openai-compatible: OpenAI https://api.openai.com/v1, OpenRouter https://openrouter.ai/api/v1, Ollama http://ollama:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Cheap model classifies everything; strong model analyzes only important items.
LLM_CHEAP_MODEL=
LLM_STRONG_MODEL=
LLM_FALLBACK_MODEL=
LLM_DAILY_TOKEN_LIMIT=300000
LLM_MAX_TOKENS_PER_TASK=1200
# Items with heuristic/cheap score >= threshold get strong-model analysis
LLM_ANALYZE_THRESHOLD=55
# Max items analyzed by the strong model per run
LLM_MAX_STRONG_PER_RUN=15
# Optional pricing override, USD per 1M tokens: {"model-id":[input,output]}
LLM_PRICING=

# ---------- Collectors ----------
GITHUB_TOKEN=
FETCH_TIMEOUT_MS=15000

# ---------- Notifications (daily digest to chat; optional, can also be set in Settings → Secrets) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# Slack/Discord incoming webhook
NOTIFY_WEBHOOK_URL=

# ---------- Scheduler (docker compose cron service) ----------
DAILY_JOB_CRON="0 6 * * *"
